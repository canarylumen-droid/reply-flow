# Example .env for local development and guidance for production (DO NOT commit real secrets)

# -----------------------------
# Backend (blog-backend) - Railway service variables
# -----------------------------
# MongoDB connection string (set this in Railway, do NOT commit real credentials)
MONGO_URI="mongodb+srv://<DB_USER>:<DB_PASS>@cluster0.mongodb.net/<DB_NAME>?retryWrites=true&w=majority"
# Alternative env name supported by the backend
DATABASE_URL_MONGODB_URI="mongodb+srv://<DB_USER>:<DB_PASS>@cluster0.mongodb.net/<DB_NAME>?retryWrites=true&w=majority"

# Public site host used for canonical URLs, sitemap, RSS
SITE_HOST="https://replyflow.pro"

# Production port for backend
PORT=4000

# Node environment
NODE_ENV=production

# Optional integrations (only if you use them)
INDEXNOW_KEY="<your-indexnow-key>"
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON='{"type":"service_account", ... }'

# -----------------------------
# Frontend (root) - Railway service variables
# -----------------------------
# This is critical: set this BEFORE building the frontend on Railway.
# It tells the frontend where to fetch blog data from.
VITE_BLOG_API_URL="https://<your-backend-railway-url>"   # e.g. https://my-backend.up.railway.app

# Build-time environment
NODE_ENV=production

# -----------------------------
# Optional (single static-server service using server.js proxy)
# -----------------------------
# If you serve both frontend and backend from a single Railway service using the
# included server.js proxy for convenience, set this to your backend URL.
BLOG_BACKEND_URL="https://<your-backend-railway-url>"

# -----------------------------
# Notes
# -----------------------------
# 1) Never commit real secrets (MONGO_URI, INDEXNOW_KEY, GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON)
# 2) Use Railway Dashboard > Variables to securely store these values for each service.
# 3) For the frontend, set VITE_BLOG_API_URL BEFORE the build step so it's embedded into the bundle.
# 4) You can copy values from this file into Railway; keep the real secrets only in Railway.
