# MySQL connection for blog backend
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://user:password@host:port/database"
# Also supported:
MYSQL_URL="mysql://user:password@host:port/database"

# Optional host used for RSS/sitemap and canonical URLs
SITE_HOST="https://replyflow.pro"

# Optional Google Indexing/IndexNow integration
INDEXNOW_KEY="your-indexnow-key"
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON="{...}"

# Production port if running standalone
PORT=4000

# If deploying the frontend separately, set this so the frontend knows the backend URL
VITE_BLOG_API_URL="https://your-backend.up.railway.app"

# Optional: server-side proxy target used by the static server when running locally
BLOG_BACKEND_URL="http://localhost:4000"
