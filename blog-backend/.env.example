# MongoDB connection for blog backend
MONGO_URI="mongodb+srv://<username>:<password>@replyflow-blog.ei8stoo.mongodb.net/?retryWrites=true&w=majority"
# Alternative MongoDB env name supported by the backend
DATABASE_URL_MONGODB_URI="mongodb+srv://<username>:<password>@replyflow-blog.ei8stoo.mongodb.net/?retryWrites=true&w=majority"

# Optional host used for RSS/sitemap state and canonical URLs
SITE_HOST="https://replyflow.pro"

# Optional Google Indexing/IndexNow integration
INDEXNOW_KEY="your-indexnow-key"
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON="{...}"

# Production port if running standalone
PORT=4000

# If deploying the frontend separately, set this to the frontend build env so it knows the backend URL
# Example for production frontend build: VITE_BLOG_API_URL="https://your-backend.up.railway.app"
# Optional: server-side proxy target used by the static server when running locally
BLOG_BACKEND_URL="http://localhost:4000"
