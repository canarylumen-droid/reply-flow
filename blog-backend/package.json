{
  "name": "replyflow-blog-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "start": "node -r dotenv/config ./dist/app.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "sync": "ts-node src/syncPosts.ts"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "dompurify": "^3.0.8",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "googleapis": "^121.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^22.1.0",
    "mysql2": "^3.22.5",
    "remark": "^14.0.2",
    "remark-html": "^15.0.1",
    "sequelize": "^6.37.8",
    "slugify": "^1.6.6",
    "typescript": "^5.4.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^20.3.1",
    "@types/sequelize": "^4.28.20",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0"
  }
}
