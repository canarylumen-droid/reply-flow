{
  "rewrites": [
    { "source": "/(.*\\.(css|js|map|png|jpg|jpeg|svg|ico|json|xml|txt))", "destination": "/$1" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ]
}
